generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  discordId String   @unique
  username  String
  avatar    String?
  email     String?
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  character      Character?
  subscriptions  Subscription[]
  purchases      Purchase[]
  marketListings MarketListing[]
  clanMember     ClanMember?
  clanMessages   ClanMessage[]
  sentTrades     TradeOffer[]        @relation("TradeFrom")
  receivedTrades TradeOffer[]        @relation("TradeTo")
  realPurchases  RealStorePurchase[]
}

model Character {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String
  element   String?
  level     Int      @default(1)
  exp       Int      @default(0)
  money     Int      @default(100)
  chi       Int      @default(50)
  maxChi    Int      @default(50)
  hp        Int      @default(100)
  maxHp     Int      @default(100)
  attack    Int      @default(25)
  defense   Int      @default(20)
  wins      Int      @default(0)
  losses    Int      @default(0)
  isActive  Boolean  @default(true)

  // ─── Pontos de atributo ganhos ao subir de nível,
  // gastos no Skill Tree (skills-upgrade.js) ───
  attributePoints Int @default(0)

  // ─── Nível de cada skill desbloqueada (skills-upgrade.js v6.0) ───
  // ex: { "dobra_fogo": 3, "raio_azul": 1 }
  skillUpgrades Json @default("{}")

  // ─── Árvore de talentos (skills-upgrade.js v6.0) ───
  // ex: { "corpo": 2, "espirito": 1, "combate": 3 }
  talentTree Json @default("{\"corpo\":0,\"espirito\":0,\"combate\":0}")

  elo       Int      @default(500)
  rankTier  String   @default("bronze")
  peakElo   Int      @default(500)

  // ─── Skills desbloqueadas (pool disponível) ───
  unlockedSkills Json @default("[]")

  // ─── Skills EQUIPADAS para a arena ───
  // Free: até 3 slots; Premium: até 6 slots
  equippedSkills Json @default("[]")

  // ─── Bônus de clã/colônia ativado? ───
  clanBuffActive Boolean @default(true)

  storyProfile Json  @default("{\"wise\":0,\"aggressive\":0,\"fearful\":0}")
  elementProfile Json @default("{\"Fogo\":0,\"Água\":0,\"Terra\":0,\"Ar\":0}")

  battlesToday    Int      @default(0)
  battlesResetAt  DateTime @default(now())

  // ─── Limite de missões concluídas hoje (plano free: 1/dia) ───
  questsCompletedToday Int      @default(0)
  questsResetAt        DateTime @default(now())

  // ─── Cooldown entre capítulos da história (30 min) ───
  lastChapterCompletedAt DateTime?

  createdAt DateTime @default(now())
  lastReset DateTime @default(now())

  user          User            @relation(fields: [userId], references: [id])
  inventory     InventoryItem[]
  quests        UserQuest[]
  battleLogs    BattleLog[]
  storyProgress StoryProgress?
  cooldowns     SkillCooldown[]
}

model SkillCooldown {
  id          String   @id @default(cuid())
  characterId String
  skillId     String
  readyAt     DateTime

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, skillId])
}

model Clan {
  id          String   @id @default(cuid())
  name        String   @unique
  element     String
  description String?
  level       Int      @default(1)
  treasury    Int      @default(0)
  exp         Int      @default(0)
  wins        Int      @default(0)
  createdAt   DateTime @default(now())

  // ─── v5.0 ─── visibilidade + capacidade + customização
  visibility  String   @default("public")    // "public" | "private"
  maxMembers  Int      @default(10)
  bannerColor String?                        // hex color para o estandarte
  motto       String?                        // lema curto

  // ─── v6.3 ─── trofeus e buffs de evento de clã
  championBadges Json   @default("[]")       // [{ eventId, eventName, season, awardedAt }]
  // Buff de evento ativo (vence em buffExpiresAt). Tipo "exp_yuan_boost" → +5%
  buffType       String?
  buffValue      Float?                      // 0.05 = +5%
  buffExpiresAt  DateTime?

  members          ClanMember[]
  warsAsChallenger ClanWar[]    @relation("Challenger")
  warsAsDefender   ClanWar[]    @relation("Defender")
  messages         ClanMessage[]
  invites          ClanInvite[]
  joinRequests     ClanJoinRequest[]
  bans             ClanBan[]
}

model ClanMember {
  id       String   @id @default(cuid())
  clanId   String
  userId   String   @unique
  role     String   @default("member")        // "owner" | "officer" | "member"
  joinedAt DateTime @default(now())
  // contribuição pessoal pro baú (estatística)
  contributedYuan Int @default(0)

  clan Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── v5.0 ─── chat do clã (polling 5s)
model ClanMessage {
  id        String   @id @default(cuid())
  clanId   String
  userId    String
  content   String   @db.VarChar(500)
  createdAt DateTime @default(now())

  clan Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clanId, createdAt])
}

// ─── v5.0 ─── convites enviados pelos officers/owner
model ClanInvite {
  id          String   @id @default(cuid())
  clanId     String
  invitedUserId String
  invitedBy   String                          // userId de quem convidou
  status      String   @default("pending")    // "pending" | "accepted" | "rejected" | "expired"
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  clan Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@unique([clanId, invitedUserId])
  @@index([invitedUserId, status])
}

// ─── v5.0 ─── pedidos para entrar em clãs privados
model ClanJoinRequest {
  id        String   @id @default(cuid())
  clanId    String
  userId    String
  message   String?  @db.VarChar(200)
  status    String   @default("pending")     // "pending" | "approved" | "rejected"
  createdAt DateTime @default(now())

  clan Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@unique([clanId, userId])
  @@index([clanId, status])
}

// ─── v5.0 ─── banimentos (impedem o usuário de entrar de novo)
model ClanBan {
  id        String   @id @default(cuid())
  clanId    String
  userId    String
  bannedBy  String
  reason    String?
  createdAt DateTime @default(now())

  clan Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@unique([clanId, userId])
}

model ClanWar {
  id            String   @id @default(cuid())
  challengerId  String
  defenderId    String
  challengerPts Int      @default(0)
  defenderPts   Int      @default(0)
  status        String   @default("active")
  endsAt        DateTime
  createdAt     DateTime @default(now())

  challenger Clan @relation("Challenger", fields: [challengerId], references: [id])
  defender   Clan @relation("Defender", fields: [defenderId], references: [id])
}

model StoryProgress {
  id          String   @id @default(cuid())
  characterId String   @unique
  chapter     Int      @default(1)
  scene       Int      @default(0)
  choices     Json     @default("{}")
  completed   Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  character Character @relation(fields: [characterId], references: [id])
}

model Subscription {
  id        String    @id @default(cuid())
  userId    String?
  guildId   String?
  planType  String
  status    String    @default("active")
  expiresAt DateTime?
  paymentId String?
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model StoreItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  priceCents  Int
  type        String
  rarity      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  purchases Purchase[]
}

model Purchase {
  id          String   @id @default(cuid())
  userId      String
  storeItemId String
  purchasedAt DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id])
  storeItem StoreItem @relation(fields: [storeItemId], references: [id])
}

model InventoryItem {
  id                   String   @id @default(cuid())
  characterId          String
  itemName             String
  quantity             Int      @default(1)
  isEquipped           Boolean  @default(false)  // p/ equipamentos (arma/armadura/amuleto)
  isConsumableEquipped Boolean  @default(false)  // p/ poções/consumíveis prontos p/ arena
  createdAt            DateTime @default(now())

  character Character @relation(fields: [characterId], references: [id])
}

model BattleLog {
  id              String   @id @default(cuid())
  characterId     String
  opponentName    String
  opponentElement String
  result          String
  expGained       Int      @default(0)
  moneyGained     Int      @default(0)
  eloChange       Int      @default(0)
  // ─── Histórico de movimentos da batalha (para replays/anti-cheat) ───
  moveHistory     Json     @default("[]")
  createdAt       DateTime @default(now())

  character Character @relation(fields: [characterId], references: [id])
}

model MarketListing {
  id         String   @id @default(cuid())
  sellerId   String
  itemName   String
  quantity   Int
  priceMoney Int
  createdAt  DateTime @default(now())

  seller User @relation(fields: [sellerId], references: [id])
}

model CraftRecipe {
  id            String   @id @default(cuid())
  name          String
  resultItem    String
  requiredItems Json
  requiredYuan  Int
  rarity        String   @default("common")
  createdAt     DateTime @default(now())
}

model RealStoreItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  priceReal   Int
  rewardYuan  Int
  rewardItem  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ─── Missões criadas pelo admin (mural oficial) ───
model AdminQuest {
  id            String   @id @default(cuid())
  title         String
  description   String
  type          String
  // ─── Filtro de elemento ───
  // "any" = aparece p/ todos os elementos (default)
  // "Fogo" / "Água" / "Terra" / "Ar" = só aparece p/ dobradores desse elemento
  element       String   @default("any")
  minLevel      Int      @default(1)
  maxLevel      Int      @default(100)
  maxProgress   Int
  rewardExp     Int
  rewardYuan    Int
  rewardItem    String?
  durationHours Int      @default(24)   // ← TEMPO p/ completar após aceitar
  isActive      Boolean  @default(true)
  createdBy     String
  createdAt     DateTime @default(now())
}

model UserQuest {
  id            String    @id @default(cuid())
  characterId   String
  adminQuestId  String?
  title         String
  description   String
  type          String
  progress      Int       @default(0)
  maxProgress   Int
  rewardExp     Int
  rewardYuan    Int
  rewardItem    String?
  acceptedAt    DateTime  @default(now())
  expiresAt     DateTime?
  isCompleted   Boolean   @default(false)
  isFailed      Boolean   @default(false)   // expirou sem completar
  createdAt     DateTime  @default(now())

  character Character @relation(fields: [characterId], references: [id])
}

model YuanStoreItem {
  id          String   @id @default(cuid())
  name        String
  description String
  type        String
  icon        String   @default("📦")
  priceYuan   Int
  minLevel    Int      @default(1)
  rarity      String   @default("common")
  stock       Int      @default(-1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ─── v6.2 ─── Mercado de Yuans com rotação diária
// 1 skill + 3 itens + 2 poções sorteados todo dia (UTC).
// Criado on-demand pela primeira chamada de GET /api/yuanstore/today no dia.
model DailyStore {
  id          String   @id @default(cuid())
  date        String   @unique          // "2026-04-30" (UTC)
  skillId     String                    // id da skill sorteada
  itemIds     String[] @default([])     // 3 ids de itens equipáveis
  potionIds   String[] @default([])     // 2 ids de poções
  refreshedAt DateTime @default(now())

  @@index([date])
}

// ─── v6.2 ─── Evento de Batalha de Clãs (lançado pelo admin)
// Janela com início e fim, durante a qual clãs podem se enfrentar e
// os pontos contam pra um leaderboard. Admin abre, fecha e reseta pontuações.
model ClanWarEvent {
  id          String   @id @default(cuid())
  name        String                            // ex.: "Batalha das Quatro Nações"
  description String?
  startsAt    DateTime
  endsAt      DateTime
  status      String   @default("scheduled")    // scheduled | active | finished
  createdBy   String                            // userId do admin
  createdAt   DateTime @default(now())
  // Pontuações registradas em scoreboard JSON: { clanId: pontos }
  scoreboard  Json     @default("{}")

  @@index([status, startsAt])
}

// ─── v6.2 ─── Bloco de notas privado do admin para skills futuras
// Não interfere em nada do jogo — é um rascunho persistente.
model AdminNote {
  id          String   @id @default(cuid())
  category    String   @default("skill")  // skill | item | feature | bug
  title       String
  element     String?                     // Fogo | Água | Terra | Ar | null
  description String                      // texto livre (markdown ok)
  metadata    Json     @default("{}")     // { damage, chiCost, cooldown, value, etc }
  createdBy   String                      // userId do admin que criou
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, updatedAt])
}

model TradeOffer {
  id                     String    @id @default(cuid())
  fromUserId             String
  toUserId               String
  offeredItemName        String
  offeredItemInventoryId String
  requestedItemName      String
  message                String    @default("")
  status                 String    @default("pending")
  expiresAt              DateTime
  completedAt            DateTime?
  createdAt              DateTime  @default(now())

  fromUser User @relation("TradeFrom", fields: [fromUserId], references: [id])
  toUser   User @relation("TradeTo", fields: [toUserId], references: [id])
}

// ─── v5.1 ─── Escambo múltiplo dentro do clã
model ClanTrade {
  id           String    @id @default(cuid())
  clanId       String
  fromUserId   String
  toUserId     String?                       // null = aberto a qualquer membro do clã

  offerItems   Json                          // [{itemName, qty}, ...]
  offerYuan    Int       @default(0)
  requestItems Json                          // [{itemName, qty, elementReq, levelReq}, ...]
  requestYuan  Int       @default(0)

  message      String?   @db.VarChar(200)
  status       String    @default("pending") // pending | accepted | rejected | expired | cancelled
  expiresAt    DateTime
  acceptedBy   String?                       // userId de quem aceitou (caso aberta)
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  @@index([clanId, status])
  @@index([fromUserId])
  @@index([toUserId])
}

// ─── v5.2 ─── Training Grounds: registro de bosses derrotados
model BossDefeat {
  id           String   @id @default(cuid())
  characterId  String
  bossId       String                              // ex: "fire_10_sozin"
  nation       String                              // "Fogo" | "Água" | "Terra" | "Ar"
  tier         Int                                 // 1-10
  firstWin     DateTime @default(now())
  totalWins    Int      @default(1)
  lastWinAt    DateTime @default(now())

  @@unique([characterId, bossId])
  @@index([characterId, nation])
}

model StoreRotation {
  id        String   @id @default(cuid())
  expiresAt DateTime
  createdAt DateTime @default(now())

  items RealStoreItem_rotation[]
}

model RealStoreItem_rotation {
  id          String  @id @default(cuid())
  rotationId  String
  poolItemId  String
  name        String
  type        String
  element     String  @default("Neutro")
  rarity      String
  priceCents  Int
  totalStock  Int     @default(50)
  soldCount   Int     @default(0)
  itemId      String?
  rewardYuan  Int     @default(0)
  minLevel    Int     @default(1)
  description String  @default("")

  rotation  StoreRotation       @relation(fields: [rotationId], references: [id])
  purchases RealStorePurchase[]
}

model RealStorePurchase {
  id          String   @id @default(cuid())
  userId      String
  storeItemId String
  paymentId   String   @unique
  createdAt   DateTime @default(now())

  user      User                   @relation(fields: [userId], references: [id])
  storeItem RealStoreItem_rotation @relation(fields: [storeItemId], references: [id])
}
