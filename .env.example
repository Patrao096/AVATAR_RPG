# ─── Servidor ───
PORT=5000
NODE_ENV=production

# ─── Banco de dados (PostgreSQL) ───
DATABASE_URL="postgresql://usuario:senha@host:5432/avatar_rpg?schema=public"
# Pula o prisma db push automatico no boot (use "true" se ja migrou manualmente)
SKIP_DB_PUSH=false

# ─── Autenticacao ───
JWT_SECRET="troque-por-uma-string-aleatoria-longa-e-secreta"

# ─── Discord OAuth ───
DISCORD_CLIENT_ID="000000000000000000"
DISCORD_CLIENT_SECRET="seu-client-secret"
DISCORD_REDIRECT_URI="https://seu-site.com/auth/callback"
DISCORD_BOT_PERMISSIONS="0"
DISCORD_SUPPORT_INVITE="https://discord.gg/seu-convite"

# IDs de admin separados por virgula (mesmos no backend e no bot)
ADMIN_DISCORD_IDS="000000000000000000,111111111111111111"

# ─── Comunicacao com o bot ───
# Segredo compartilhado entre backend e bot (qualquer string longa e secreta)
BOT_INTERNAL_SECRET="troque-por-um-segredo-compartilhado-com-o-bot"

# ─── URLs ───
FRONTEND_URL="https://seu-site.com"
BACKEND_URL="https://seu-backend.com"

# ─── Pagamentos (Mercado Pago) ───
MP_ACCESS_TOKEN="seu-access-token-do-mercado-pago"
PLAN_PREMIUM_USER_CENTS=1990
PLAN_PREMIUM_SERVER_CENTS=4990

# Sincronizacao de schema no boot. Por padrao desligado (false): o db push roda
# no BUILD do deploy, nao a cada inicializacao, evitando timeout de boot na Discloud.
# Ligue (true) apenas se quiser que o servidor rode "prisma db push" toda vez que iniciar.
DB_PUSH_ON_BOOT=false
